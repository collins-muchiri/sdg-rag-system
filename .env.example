# Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/sdg_rag_db
REDIS_URL=redis://localhost:6379/0

# Vector Database
CHROMA_DB_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Security
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External API Keys
# Transportation APIs
UBER_API_KEY=your_uber_api_key
GRAB_API_KEY=your_grab_api_key
TFL_API_KEY=your_transport_for_london_api_key
SMARTCAR_CLIENT_ID=your_smartcar_client_id
SMARTCAR_CLIENT_SECRET=your_smartcar_client_secret
OPEN_CHARGE_MAP_API_KEY=your_open_charge_map_api_key

# UN/SDG APIs
UN_DATA_API_KEY=your_un_data_api_key
UN_HABITAT_API_KEY=your_un_habitat_api_key
WORLD_BANK_API_KEY=your_world_bank_api_key

# File Processing
MAX_FILE_SIZE=100MB
SUPPORTED_FORMATS=pdf,docx,txt,md,pptx
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# Monitoring
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Caching
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2